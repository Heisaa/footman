{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/guard-slow-runs.sh\"",
            "timeout": 10,
            "statusMessage": "Checking for a long-running command"
          }
        ]
      }
    ]
  }
}
